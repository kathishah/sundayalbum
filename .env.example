# Sunday Album Environment Variables
# Copy this file to .env and fill in your API keys

# Anthropic Claude API key (for AI quality assessment)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API key (fallback for AI features)
OPENAI_API_KEY=sk-...

# Debug settings
SUNDAY_ALBUM_DEBUG=1
SUNDAY_ALBUM_LOG_LEVEL=DEBUG

# Deployment configuration (only needed to deploy the AWS stack; see docs/OPERATIONS.md).
# Never commit real values. Prefer passing these on the command line or from your shell profile.
# AWS_ACCOUNT_ID=<your-12-digit-account-id>        # used by scripts/backfill_thumbnails.py
# SUNDAYALBUM_ADMIN_EMAILS=you@example.com         # comma-separated; read by `cdk deploy`
# TEST_USER_EMAIL=you@example.com                  # verified dev test user for the Playwright suite
